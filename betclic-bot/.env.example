# --- The Odds API (https://the-odds-api.com) — plan gratuit = 500 crédits/mois
ODDS_API_KEY=

# --- Telegram : créer un bot via @BotFather, récupérer le chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Coffre Obsidian (par défaut : dossier parent de betclic-bot/)
VAULT_PATH=
TIMEZONE=Europe/Paris

# --- Bankroll : laisser BANKROLL vide pour la calculer depuis « 03 - Bilan & Bankroll/Bankroll.md »
BANKROLL=
DEFAULT_BANKROLL=1000

# --- Quota (1 crédit par sport scanné : marché h2h seul)
MONTHLY_CREDITS=500
CREDIT_RESERVE=30
RUNS_PER_DAY=2
MAX_SPORTS_PER_RUN=10
LOOKAHEAD_HOURS=48

# --- Cache des statistiques ESPN (par défaut : data/espn_cache)
STATS_CACHE_PATH=

# --- Dé-vigging : multiplicative (prudent, défaut) ou power
DEVIG_METHOD=multiplicative
